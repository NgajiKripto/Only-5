# Telegram Bot Token (required) - Get from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenRouter API Key (required) - For LLM access
OPENROUTER_API_KEY=

# Solana Private Key (required) - Base58 encoded
SOLANA_PRIVATE_KEY=

# Solana RPC URL (default: https://api.mainnet-beta.solana.com)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# GitHub Token (optional) - For bounty hunting strategy
GITHUB_TOKEN=

# Log Level (default: info) - debug, info, warn, error
LOG_LEVEL=info

# Database Path (default: ./data/only5.db)
DB_PATH=./data/only5.db

# Agent Name (default: Only-5)
AGENT_NAME=Only-5
